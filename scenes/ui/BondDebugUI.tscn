[gd_scene format=3 uid="uid://bbonddebugui"]

[ext_resource type="Script" path="res://scripts/ui/bond_debug_ui.gd" id="1_ui"]

[node name="BondDebugUI" type="Window"]
title = "Bond & Relationship Debug"
position = Vector2i(40, 40)
size = Vector2i(680, 920)
min_size = Vector2i(560, 520)
visible = true
script = ExtResource("1_ui")

[node name="Margin" type="MarginContainer" parent="."]
