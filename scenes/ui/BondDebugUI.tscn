[gd_scene format=3 uid="uid://bbonddebugui"]

[ext_resource type="Script" path="res://scripts/ui/bond_debug_ui.gd" id="1_ui"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill_panel"]
bg_color = Color(0, 0, 0, 0)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_content_panel"]
bg_color = Color(0.2, 0.22, 0.26, 1)

[node name="BondDebugUI" type="Control"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
visible = true
script = ExtResource("1_ui")

[node name="FillPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_fill_panel")

